+      next.push({a, b, w});
+      segs = next.sort((x, y) => x.a - y.a);
+    }
+    const merged: typeof segs = [];
+    segs.forEach((sg) => {
+      const last = merged[merged.length - 1];
+      if (last && last.w === sg.w && last.b === sg.a) {last.b = sg.b;} else {merged.push(sg);}
+    });
+    return merged;
+  }
