+      }
+    }
+    return {
+      key, level, t0, t1, buckets, exact: !!h.exact, counts, hiddenAfter,
+      data: {valueChangeData: records, formattedValues: {}, signalWidth: width, min: h.min ?? 0, max: h.max ?? 1},
