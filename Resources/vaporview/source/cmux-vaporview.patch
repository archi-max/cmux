+    this.scheduleRedraw();
+  }
+
+  private sendWindow(span: Tile[], priority: number, buckets: number, who: SignalWindows[]) {
+    const id = this.nextId++;
+    who.forEach((s) => span.forEach((t) => s.inflight.add(t.key)));
