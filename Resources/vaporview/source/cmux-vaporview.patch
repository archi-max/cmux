+        if (sg.b <= a || sg.a >= b) {next.push(sg); continue;}
+        if (sg.a < a) {next.push({a: sg.a, b: a, w: sg.w});}
+        if (sg.b > b) {next.push({a: b, b: sg.b, w: sg.w});}
