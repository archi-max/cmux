+      if (s.orphanSince === null) {s.orphanSince = now; return;}
+      if (now - s.orphanSince < 5000 || s.windows.size === 0) {return;}
+      s.windows.clear(); s.bytes = 0; s.painted.clear(); s.valueAt = null;
