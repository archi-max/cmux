+      s.hybrid = 'windowed';
+      return;
+    }
+    // Over budget only with the loads still pending: those may fail and free it, so decide
+    // again later rather than for good (review L3).
+    if (this.hybridBytes + this.hybridPending + est > this.hybridBudget) {
