+export function disassembleRiscv(word: number, opts: RiscvDisasmOptions = {}): string | null {
+  if (opts.pc !== undefined) {return new Disassembler(opts).decode(word);}
+  const key = (opts.abiNames !== false ? "a" : "n") + (opts.aliases !== false ? "p" : "r");
