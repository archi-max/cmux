+    // Signals the host keeps failing on (unreadable) or timing out on (slow) don't hold refinement up.
+    const done = sigs.every((s) => s.fails > 0 || s.timeouts > 0 || visible.every((t) => s.windows.has(t.key) || this.coveredExact(s, t)));
